{
    "id": "niuren.blog",
    "name": "朋友圈博客",
    "description": "模仿朋友圈风格轻博客，支持前台发布动态与文章。",
    "version": "1.3.0",
    "author": "CmsPro",
    "require": {
        "php": ">=8.1",
        "cmspro": ">=5.0.0"
    },
    "providers": ["ServiceProvider"],
    "install": "Install",
    "home_routes": {
        "/blog": "朋友圈动态流",
        "/blog/write": "写动态",
        "/blog/publish": "发布动态",
        "/blog/{id}": "动态详情"
    },
    "menus": [
        {
            "title": "朋友圈博客",
            "icon": "fa fa-comments-o",
            "path": "/admin/niuren/blog",
            "code": "niuren_blog_root",
            "order": 100,
            "children": [
                { "title": "文章管理", "icon": "fa fa-file-text-o", "path": "/admin/niuren/blog/posts", "code": "niuren_blog_posts", "order": 1 },
                { "title": "博客设置", "icon": "fa fa-cog", "path": "/admin/niuren/blog/setting", "code": "niuren_blog_setting", "order": 2 }
            ]
        }
    ],
    "config_groups": [
        {
            "name": "blog_settings",
            "title": "博客设置",
            "items": [
                { "name": "posts_per_page", "title": "每页文章数", "type": "number", "value": "10", "tips": "前台列表每页文章数量" },
                {
                    "name": "access_mode",
                    "title": "访问方式",
                    "type": "select",
                    "value": "root",
                    "options": [
                        { "label": "根路径", "value": "root" },
                        { "label": "路径前缀", "value": "path" },
                        { "label": "子域名绑定", "value": "domain" }
                    ],
                    "tips": "博客对外提供访问的方式：根路径（/）、路径前缀（如 /blog）或子域名绑定（如 blog.example.com），三选一"
                },
                { "name": "access_path_prefix", "title": "路径前缀", "type": "text", "value": "/blog", "tips": "访问方式为「路径前缀」时生效，以 /{前缀} 形式访问博客（如 /blog）；留空表示不启用该方式" },
                { "name": "access_domain", "title": "绑定子域名", "type": "text", "value": "", "tips": "访问方式为「子域名绑定」时生效，如 blog.example.com；留空表示不启用该方式" }
            ]
        }
    ],
    "permissions": [
        { "code": "niuren.blog.manage", "name": "博客管理" },
        { "code": "niuren.blog.post.create", "name": "创建文章" },
        { "code": "niuren.blog.post.edit", "name": "编辑文章" },
        { "code": "niuren.blog.post.delete", "name": "删除文章" }
    ],    "runtime_files": []
}